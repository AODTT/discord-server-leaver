# Public application URLs
APP_ORIGIN=http://localhost:8787
EXTENSION_ORIGINS=chrome-extension://*,https://*.chromiumapp.org
PORT=8787

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/discord_memory
MONGODB_DB=discord_memory

# Discord OAuth2 application (no bot required - uses user's OAuth token)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/discord/callback

# Generate both with a cryptographically secure random generator.
# AUTH_SECRET: at least 32 characters. TOKEN_ENCRYPTION_KEY: 32-byte base64.
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# OpenAI is called only by the backend. Never place this key in the extension.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_VECTOR_INDEX=message_vector_index

# Stripe Checkout credit packs and donation link
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_50=
STRIPE_PRICE_120=
STRIPE_PRICE_300=
DONATION_URL=
DEVELOPER_SITE_URL=

