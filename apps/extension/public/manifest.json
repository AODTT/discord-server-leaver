{
  "manifest_version": 3,
  "name": "Discord Server Leaver",
  "description": "Organize your Discord servers. Must have Discord open in browser (not the app). Leave unwanted servers in bulk or one-by-one.",
  "version": "2.1.0",
  "key": "",
  "permissions": ["storage", "scripting", "tabs", "identity"],
  "host_permissions": [
    "*://discord.com/*",
    "https://discord.com/api/*",
    "https://discord-server-leaver-production.up.railway.app/*",
    "https://stream-dream.shop/*"
  ],
  "action": {
    "default_title": "Discord Server Leaver",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
