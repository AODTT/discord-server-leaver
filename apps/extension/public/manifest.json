{
  "manifest_version": 3,
  "name": "Discord Server Leaver",
  "description": "Bulk-manage your Discord servers, search message history, schedule messages, and more.",
  "version": "2.0.0",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "*://discord.com/*",
    "https://discord.com/api/*"
  ],
  "action": {
    "default_title": "Discord Server Leaver",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
