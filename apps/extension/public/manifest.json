{
  "manifest_version": 3,
  "name": "Discord Server Leaver",
  "description": "Bulk-manage your Discord servers with a focused, private extension.",
  "version": "2.0.0",
  "permissions": ["storage", "scripting", "tabs", "identity"],
  "host_permissions": [
    "*://discord.com/*",
    "https://discord.com/api/*",
    "https://discord-server-leaver-production.up.railway.app/*",
    "https://stream-dream.shop/*"
  ],
  "action": {
    "default_title": "Discord Server Leaver",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
